# =====================================================================
# FWA Sales Digitalization — AE API
# Copy to .env and fill in. Never commit .env.
# =====================================================================

APP_ENV=development
LOG_LEVEL=INFO

# The business day is Indonesian. "Today" for attendance and every report window
# is resolved in this zone — the server is authoritative on time, never the device.
APP_TIMEZONE=Asia/Jakarta

# --- Database ---------------------------------------------------------
# asyncpg driver. The Alembic env.py rewrites this to a sync URL itself.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/api_fwa_sales_dev
DB_ECHO=false

# --- Auth -------------------------------------------------------------
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-in-every-environment
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# Shared secret for POST /internal/ga-events (X-Service-Key header).
# This endpoint must not be reachable from the public app path — block it at nginx.
SERVICE_API_KEY=change-me-service-key

# --- Login rate limit -------------------------------------------------
# AE codes are guessable by design (AE-BENGKULU1), so /auth/login is throttled
# per AE code + client IP. In-process counter: correct for the single-instance
# deployment this project uses. Revisit if the API is ever load-balanced.
LOGIN_RATE_LIMIT_ATTEMPTS=10
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300

# --- Private file storage --------------------------------------------
# Attendance selfies and documents. Kept outside the repo; served only through
# short-lived HMAC-signed URLs (GET /v1/files/{token}), never a public path.
FILE_STORAGE_DIR=./var/uploads
FILE_URL_SECRET=change-me-file-signing-secret
FILE_URL_TTL_SECONDS=300
MAX_UPLOAD_BYTES=5242880

# Absolute base used to build the signed URLs handed to the mobile app.
PUBLIC_BASE_URL=http://localhost:8000

# --- CORS -------------------------------------------------------------
# Comma-separated. The Android client does not need CORS; this is for Swagger UI.
CORS_ORIGINS=

# Accuracy tolerance in metres for GeoPoint.verified. A GPS fix reporting worse
# accuracy than this is stored but flagged unverified. This is a device-quality
# tolerance, NOT the CICO geofence radius — see the note below.
GEO_ACCURACY_TOLERANCE_M=100

# --- Deliberately absent: the CICO geofence --------------------------
# There is no GEOFENCE_RADIUS_M setting, and check-in does not evaluate a
# geofence. Two things are missing, not one: the tolerance in metres is an open
# business decision (CLAUDE.md §11.2), and the schema carries no reference point
# to measure from — neither account_executive nor region has a coordinate. Until
# both exist, within_geofence is written NULL and check-ins are AUTO_APPROVED.
# The approval workflow is modelled in the schema and ready to switch on.
